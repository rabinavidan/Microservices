# Postgres (shared instance, one database per service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
ORDERS_DB_NAME=orders_db
PAYMENTS_DB_NAME=payments_db
INVENTORY_DB_NAME=inventory_db

# HTTP ports (REST / health checks)
API_GATEWAY_HTTP_PORT=3000
ORDERS_HTTP_PORT=3001
PAYMENTS_HTTP_PORT=3002
INVENTORY_HTTP_PORT=3003
NOTIFICATIONS_HTTP_PORT=3004

# TCP ports (inter-service microservice transport)
ORDERS_TCP_PORT=4001
PAYMENTS_TCP_PORT=4002
INVENTORY_TCP_PORT=4003
NOTIFICATIONS_TCP_PORT=4004

# Service hosts (override in docker-compose to use container names)
ORDERS_HOST=localhost
PAYMENTS_HOST=localhost
INVENTORY_HOST=localhost
NOTIFICATIONS_HOST=localhost
