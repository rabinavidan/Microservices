{
  "name": "ecommerce-microservices",
  "version": "1.0.0",
  "private": true,
  "description": "Production-style e-commerce microservices platform built with TypeScript and NestJS",
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "format": "prettier --write \"apps/**/src/**/*.ts\" \"libs/**/src/**/*.ts\"",
    "start:gateway": "npm run start:dev -w apps/api-gateway",
    "start:orders": "npm run start:dev -w apps/orders-service",
    "start:payments": "npm run start:dev -w apps/payments-service",
    "start:inventory": "npm run start:dev -w apps/inventory-service",
    "start:notifications": "npm run start:dev -w apps/notifications-service"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/testing": "^10.4.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
